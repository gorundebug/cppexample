define git-push-dir
	@set -eu; \
	host="$(3)"; \
	repo="$(4)"; \
	if [ "$$host" = "gitlab.com" ]; then \
	  $(GLAB) repo create $$repo --public 2>/dev/null || true; \
	else \
	  $(GH) repo create $$repo --public 2>/dev/null || true; \
	fi; \
	tmp=$$(mktemp -d); \
	trap 'rm -rf "$$tmp"' EXIT INT TERM; \
	stage="$$tmp/stage"; \
	work="$$tmp/repository"; \
	mkdir -p "$$stage"; \
	if [ "$(5)" = "cpp-service" ]; then \
	  ./scripts/package-cpp-service.generated.sh "./$(1)" "$$stage"; \
	elif [ "$(5)" = "python-service" ]; then \
	  ./scripts/package-python-service.generated.sh "./$(1)" "$$stage"; \
	elif [ "$(5)" = "rust-service" ]; then \
	  ./scripts/package-rust-service.generated.sh "./$(1)" "$$stage"; \
	elif [ "$(5)" = "typescript-service" ]; then \
	  ./scripts/package-typescript-service.generated.sh "./$(1)" "$$stage"; \
	else \
	  cp -r ./$(1)/. "$$stage/"; \
	fi; \
	rm -rf "$$stage/.git"; \
	git clone -q "git@$$host:$$repo.git" "$$work"; \
	git -C "$$work" rm -rq --ignore-unmatch .; \
	cp -r "$$stage/." "$$work/"; \
	git -C "$$work" add -A; \
	if ! git -C "$$work" diff --cached --quiet; then \
	  git -C "$$work" -c user.email="local@dev" -c user.name="local" commit -q -m "release $(2)"; \
	fi; \
	git -C "$$work" tag $(2); \
	git -C "$$work" push --atomic origin HEAD:main refs/tags/$(2)
endef


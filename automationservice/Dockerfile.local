# Runtime image — binary is pre-built on host via 'make service_build_linux'
# Includes Delve debugger; set DEBUG=1 in .env to activate.
# Build context: project root (docker build -f Dockerfile.local -t automationservice:latest ..)

# ── stage 1: build Delve debugger ────────────────────────────────────────────
FROM golang:1.25-bookworm AS dlv-builder
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}
ARG GOSUMDB=sum.golang.org
ENV GOSUMDB=${GOSUMDB}
RUN go install github.com/go-delve/delve/cmd/dlv@latest

# ── stage 2: runtime ─────────────────────────────────────────────────────────
FROM debian:bookworm-slim

ARG SERVICEGEN_APT_DEBIAN_URL=
ARG SERVICEGEN_APT_DEBIAN_SECURITY_URL=
RUN if [ -n "$SERVICEGEN_APT_DEBIAN_URL$SERVICEGEN_APT_DEBIAN_SECURITY_URL" ]; then \
      find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) -exec sed -i \
        -e "s|http://deb.debian.org/debian-security|$SERVICEGEN_APT_DEBIAN_SECURITY_URL|g" \
        -e "s|http://deb.debian.org/debian|$SERVICEGEN_APT_DEBIAN_URL|g" {} +; \
    fi
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=dlv-builder /go/bin/dlv /usr/local/bin/dlv

WORKDIR /app

COPY bin/automationservice ./service
COPY automationservice/config/ ./config/
COPY automationservice/docker-entrypoint.generated.sh ./docker-entrypoint.generated.sh
RUN chmod +x ./docker-entrypoint.generated.sh

EXPOSE 9094
EXPOSE 9204
EXPOSE 2345

ENTRYPOINT ["./docker-entrypoint.generated.sh", "-config", "./config/config.yaml", "-values", "./config/overrides.yaml"]
go 1.25.4

use (
	./automationservice
	./inventory_service_api
	./model_go
	./order_service_api
)

// Keep the hybrid workspace reproducible before its sibling modules are
// published. The version-qualified replacements apply only while GOWORK points
// at this file; autonomous service builds use their pinned repositories.
replace (
	github.com/gorundebug/cppexample-inventory-service-api v0.2.14 => ./inventory_service_api
	github.com/gorundebug/cppexample/model_go v0.2.14 => ./model_go
	github.com/gorundebug/cppexample-order-service-api v0.2.14 => ./order_service_api
)
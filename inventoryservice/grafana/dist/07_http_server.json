            "h": 1,
            "w": 0,
            "x": 0,
            "y": 0
         },
         "id": 1,
         "panels": [ ],
         "title": "Traffic",
         "type": "row"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "short"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 8,
            "x": 0,
            "y": 1
         },
         "id": 2,
         "pluginVersion": "v11.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "http_handler_in_flight{job=~\"$job\", http_handler=~\"$http_handler\"}",
               "intervalFactor": 2,
               "legendFormat": "{{http_handler}} {{http_path}}"
            }
         ],
         "title": "Active Requests",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "ops"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 16,
            "x": 8,
            "y": 1
         },
         "id": 3,
         "pluginVersion": "v11.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "rate(http_handler_rps{job=~\"$job\", http_handler=~\"$http_handler\"}[$__rate_interval])",
               "intervalFactor": 2,
               "legendFormat": "{{http_handler}} {{http_path}}"
            }
         ],
         "title": "Request Rate",
         "type": "timeseries"
      },

               "expr": "rate(http_handler_reply_codes{job=~\"$job\", http_handler=~\"$http_handler\", http_code=~\"4..|5..\"}[$__rate_interval])",
               "intervalFactor": 2,
               "legendFormat": "{{http_code}} {{http_handler}} {{http_path}}"
            }
         ],
         "title": "Error Rate (4xx + 5xx)",
         "type": "timeseries"
      }
   ],
   "refresh": "30s",
   "schemaVersion": 39,
   "tags": [
      "servicelib",
      "http",
      "server",
      "servicelib"
   ],
   "templating": {
      "list": [
         {
            "label": "Datasource",
            "name": "datasource",
            "query": "prometheus",
            "type": "datasource"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "$datasource"
            },
            "includeAll": false,
            "label": "Job",
            "multi": false,
            "name": "job",
            "query": "label_values(http_handler_rps, job)",
            "regex": "(?i)^inventory[ _-]*service$",
            "type": "query"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "$datasource"
            },
            "includeAll": true,
            "label": "Http_handler",
            "multi": true,
            "name": "http_handler",
            "query": "label_values(http_handler_rps{job=~\"$job\"}, http_handler)",
            "type": "query"
         }
      ]
   },
   "time": {
      "from": "now-1h",
      "to": "now"
   },
   "timezone": "browser",
   "title": "inventoryservice / HTTP Server",
   "uid": "inventoryservice-http-server"
}

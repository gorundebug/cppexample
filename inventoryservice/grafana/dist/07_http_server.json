               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "sum(rate(datasource_endpoint_request_duration_seconds_bucket{job=~\"$job\", transport=\"http\"}[$__rate_interval])) by (le)",
               "format": "heatmap",
               "intervalFactor": 2,
               "legendFormat": "{{le}}"
            }
         ],
         "title": "Request Duration Heatmap",
         "type": "heatmap"
      },

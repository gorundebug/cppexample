            "y": 1
         },
         "id": 2,
         "pluginVersion": "v11.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "engine_task_processors_worker_threads{job=~\"$job\", task_processor=~\"$task_processor\"}",
               "intervalFactor": 2,
               "legendFormat": "{{task_processor}}"
            }
         ],
         "title": "Worker Threads",
         "type": "timeseries"
      },
      {
         "datasource": {

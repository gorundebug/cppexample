   "refresh": "30s",
   "schemaVersion": 39,
   "tags": [
      "servicelib",
      "runtime",
      "cpp",
      "userver"
   ],
   "templating": {
      "list": [
         {
            "label": "Datasource",
            "name": "datasource",
            "query": "prometheus",
            "type": "datasource"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "$datasource"
            },
            "includeAll": false,
            "label": "Job",
            "multi": false,
            "name": "job",
            "query": "label_values(engine_task_processors_worker_threads, job)",
            "regex": "(?i)^inventory[ _-]*service$",
            "type": "query"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "$datasource"
            },
            "includeAll": true,
            "label": "Task_processor",
            "multi": true,
            "name": "task_processor",
            "query": "label_values(engine_task_processors_worker_threads{job=~\"$job\"}, task_processor)",
            "type": "query"
         }
      ]
   },
   "time": {
      "from": "now-1h",
      "to": "now"
   },
   "timezone": "browser",
   "title": "inventoryservice / userver Runtime",
   "uid": "inventoryservice-runtime"
}

   "refresh": "30s",
   "schemaVersion": 39,
   "tags": [
      "servicelib",
      "http",
      "client"
   ],
   "templating": {
      "list": [
         {
            "label": "Datasource",
            "name": "datasource",
            "query": "prometheus",
            "type": "datasource"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "$datasource"
            },
            "includeAll": false,
            "label": "Job",
            "multi": false,
            "name": "job",
            "query": "label_values(datasink_endpoint_messages_total, job)",
            "regex": "(?i)^analytics[ _-]*service$",
            "type": "query"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "$datasource"
            },
            "includeAll": true,
            "label": "Connector",
            "multi": true,
            "name": "connector",
            "query": "label_values(datasink_endpoint_messages_total{job=~\"$job\", protocol=\"\"}, connector)",
            "type": "query"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "$datasource"
            },
            "includeAll": true,
            "label": "Endpoint",
            "multi": true,
            "name": "endpoint",
            "query": "label_values(datasink_endpoint_messages_total{job=~\"$job\", protocol=\"\", connector=~\"$connector\"}, endpoint)",
            "type": "query"
         }
      ]
   },
   "time": {
      "from": "now-1h",
      "to": "now"
   },
   "timezone": "browser",
   "title": "analyticsservice / HTTP Client",
   "uid": "analyticsservice-http-client"
}

         "title": "Traffic",
         "type": "row"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "ops"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 1
         },
         "id": 2,
         "pluginVersion": "v11.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "rate(datasink_endpoint_messages_total{job=~\"$job\", protocol=\"\", connector=~\"$connector\", endpoint=~\"$endpoint\"}[$__rate_interval])",
               "intervalFactor": 2,
               "legendFormat": "{{connector}} / {{endpoint}}"
            }
         ],
         "title": "Request Rate",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {

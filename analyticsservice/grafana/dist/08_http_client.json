         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "datasink_endpoint_active_requests{job=~\"$job\", protocol=\"\", connector=~\"$connector\", endpoint=~\"$endpoint\"}",
               "intervalFactor": 2,
               "legendFormat": "{{connector}} / {{endpoint}}"
            }
         ],
         "title": "Active Requests",
         "type": "timeseries"
      },

diff --git a/scripts/grpc/requirements-4.txt b/scripts/grpc/requirements-4.txt
--- a/scripts/grpc/requirements-4.txt
+++ b/scripts/grpc/requirements-4.txt
@@ -1,2 +1,5 @@

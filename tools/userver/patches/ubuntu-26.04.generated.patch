diff --git a/testsuite/requirements-grpc-4.txt b/testsuite/requirements-grpc-4.txt
--- a/testsuite/requirements-grpc-4.txt
+++ b/testsuite/requirements-grpc-4.txt
@@ -1,4 +1,11 @@
-grpcio >= 1.50.0, < 1.63.0
-grpcio-tools >= 1.50.0, < 1.63.0
-grpcio-reflection >= 1.50.0, < 1.63.0
-protobuf >= 4.21.12, < 5.0dev
+grpcio >= 1.50.0, < 1.63.0; python_version < "3.14"
+grpcio-tools >= 1.50.0, < 1.63.0; python_version < "3.14"
+grpcio-reflection >= 1.50.0, < 1.63.0; python_version < "3.14"
+protobuf >= 4.21.12, < 5.0dev; python_version < "3.14"
+# grpcio < 1.63 has no Python 3.14 wheels and cannot be compiled against

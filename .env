# Per-service debug switches are consumed only by `make debug-<service>`.
# Debug uses bind-mounted sources and host ports 2345+index (overridable per
# service); every container debugger listens internally on 2345: Delve for Go,
# debugpy for Python, gdbserver for C++/Rust, and Node Inspector for TypeScript.
KUBERNETES_API_PORT=6443
KUBERNETES_REGISTRY_PORT=5001
KUBERNETES_IMAGE_TAG=local
KUBERNETES_TIMEOUT=10m
ANALYTICS_SERVICE_DEBUG=0
AUTOMATION_SERVICE_DEBUG=0
INVENTORY_SERVICE_DEBUG=0
ORDER_SERVICE_DEBUG=0

# Ports for local infrastructure (change if running multiple projects simultaneously).
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Optional shared Nexus dependency proxy. Projects never set this variable.
# Export it in your shell to make every generated project automatically use the
# same long-running proxy; without it all downloads use their normal upstreams.
# DEPENDENCY_PROXY_DIR=/absolute/path/to/servicegen-dependency-proxy
DEPENDENCY_PROXY_PORT=18081
DEPENDENCY_PROXY_DOCKER_PORT=18083
DEPENDENCY_PROXY_GHCR_PORT=18085
DEPENDENCY_PROXY_QUAY_PORT=18086
DEPENDENCY_PROXY_REDPANDA_PORT=18087
DEPENDENCY_PROXY_KUBERNETES_PORT=18088
DEPENDENCY_PROXY_CLIENT_HOST=localhost
# Linux defaults this to 0.0.0.0 so containers can reach the host gateway;
# Docker Desktop defaults it to 127.0.0.1.
# DEPENDENCY_PROXY_BIND_HOST=127.0.0.1
# Read https://links.sonatype.com/products/nxrm/ce-eula before opting in once:
# DEPENDENCY_PROXY_ACCEPT_EULA=true